# Copy this file to .env.local and fill in the values from
# Supabase Dashboard -> Project Settings -> API (or "API Keys").

# Project URL, e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The anon / publishable key (safe for the browser; RLS protects the data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Used only by `npm run make-admin` on your computer.
# Never prefix with NEXT_PUBLIC_ and you do not need to add it to Vercel.
SUPABASE_SERVICE_ROLE_KEY=
